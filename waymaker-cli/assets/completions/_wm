#compdef wm

autoload -U is-at-least

_wm() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--config=[]:PATH:_files' \
'*-o+[]:PATH:_files' \
'*--override=[]:PATH:_files' \
'--group-prefix=[Specify a prefix that indicates a line is a group header]:PREFIX:_default' \
'-f+[Filter input headlessly matching query, print results to stdout, and exit without entering the TUI]:QUERY:_default' \
'--filter=[Filter input headlessly matching query, print results to stdout, and exit without entering the TUI]:QUERY:_default' \
'--download=[Download presets from GitHub. Optionally specify a subfolder]::FOLDER:_default' \
'-d+[Display documentation]:DOC:(options binds template performance frecency jump other)' \
'--doc=[Display documentation]:DOC:(options binds template performance frecency jump other)' \
'--pos=[Initial cursor position (0-based index or negative for from-the-end)]:INDEX:_default' \
'*--media=[Enable native terminal media previews (images, videos, PDFs) using ratatui-image and set properties. Examples\: --media --media size\:s --media size\:256 type\:kitty --media size\:xl]::PROP:_default' \
'--media-size=[Override the pixel resolution limit for media downscaling (images, videos, PDFs). Examples\: --media-size 1280, --media-size 800, --media-size xl, --media-size full, --media-size 0]:SIZE:_default' \
'*--color=[Colourise the UI with fzf-style key\:value pairs (comma-separated). Example\: --color border\:#cba6f7,hl-fg\:#a6e3a1,nav\:#89b4fa Keys\: fg, bg, hl-fg, hl-bg, border, label, preview-border, preview-label, list-border, list-label, input-border, input-label, header-border, header-label, nav, selected-fg, selected-bg, selected-prefix, unselected-prefix, spinner, yank, cut, symlink]:SPEC:_default' \
'*--nav=[Enable navigation mode and set properties. Examples\: --nav --nav bar blink\:slow --nav bar\:plain action-bar color\:#a6e3a1 marker\:'\''>'\'' bold --nav action-bar\:double]::PROP:_default' \
'*--nav-bind=[Navigation-mode key bindings in the form "char\:action". Example\: --nav-bind '\''h\:ChDir(..)'\'' --nav-bind '\''l\:ChDir({=});Reload'\'']:BIND:_default' \
'--dump-config[]' \
'-F[]' \
'--test-keys[]' \
'--last-key[]' \
'--no-read[Force the default command to run]' \
'(-v)*-q[Reduce the verbosity level]' \
'(-q)*-v[Increase the verbosity level]' \
'--sort[Sort input lines alphabetically before injecting into the picker]' \
'--frecency[Enable frecency tracking and re-ranking for search results]' \
'--icons[Prepend a Nerd Font file-type icon before each result row]' \
'--symlink-target[Append symlink target path after the first column when the entry is a symlink]' \
'--nav-hints[Show keybinding hints in footer/status when Results pane is focused in navigation mode]' \
'--parent-peek[Show a 3rd pane on the left displaying parent directory contents]' \
'--status-inline[Display match status counter inline on the right side of the filter input bar]' \
'-h[Print help]' \
'--help[Print help]' \
'*::args -- args passed to the start command:_default' \
&& ret=0
}

(( $+functions[_wm_commands] )) ||
_wm_commands() {
    local commands; commands=()
    _describe -t commands 'wm commands' commands "$@"
}

if [ "$funcstack[1]" = "_wm" ]; then
    _wm "$@"
else
    compdef _wm wm
fi
